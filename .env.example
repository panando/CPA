# CLIProxyAPI 环境变量示例
#
# 使用方法：
#   1. 复制本文件为 .env（与 config.yaml 同一目录）
#   2. 填写真实密钥
#   3. 在 config.yaml 中将对应的 API Key 写成 ${变量名} 占位符
#
# 注意：
#   - .env 请勿提交到 Git / 备份到不受控位置
#   - 建议权限 600：chmod 600 .env
#   - 变量名需与 config.yaml 中的 ${...} 占位符完全一致

# Ollama 本地模型
OLLAMA_API_KEY=your-ollama-api-key

# opencode go 账号 1
OPENCODE_GO_API_KEY_1=sk-your-opencode-go-key-1

# opencode go 账号 2
OPENCODE_GO_API_KEY_2=sk-your-opencode-go-key-2
